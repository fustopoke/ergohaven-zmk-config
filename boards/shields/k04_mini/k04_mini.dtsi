/*
 * Ergo Haven K:04 Mini — 46-key wireless BLE split (nRF52840 per half).
 *
 * Matrix pin map taken from Ergo Haven's own RMK sources
 * (ergohaven/rmk, keyboards/k04/keyboard_mini.toml):
 *   rows (read):  P0.28, P0.03, P1.10, P1.11
 *   cols (driven): P1.06, P1.04, P1.02, P1.00, P0.22, P0.20
 *   identical wiring on both halves; diodes col2row (same as K:03).
 *
 * Onboard indicator: a single WS2812-class smart RGB LED, data line on
 * P0.30 (RMK drives it with PWM sequences; here the Zephyr WS2812 SPI
 * backend feeds it, exposed as the ZMK underglow device for
 * ergohaven/zmk-smart-rgbled-widget).
 *
 * WHY SPI3 (and not SPI0/1/2):
 * nRF52840 silicon anomaly 198 — while SPIM3 transfers with EasyDMA,
 * any CPU RAM access in the same cycle corrupts the outgoing stream.
 * The BLE link layer touches RAM constantly, so a busy use of SPIM3 is
 * a dice roll. There is nowhere else to go, though: on the nRF52
 * family SPI0/1 are the SAME physical peripherals as TWI0/UART0 and
 * TWI1 (the board keeps a console UART and the right half's touchpad
 * owns TWIM1 — Zephyr build-asserts on those collisions), and SPI2,
 * while documented as free, did not drive the strip here (the LED
 * stayed dark on every build that tried it).
 *
 * The mitigation is therefore in the driver, not the devicetree:
 * ergohaven/zmk-smart-rgbled-widget no longer runs ZMK's 20 Hz
 * underglow refresh — it writes one frame per colour change straight
 * through the LED-strip API. One lottery ticket per colour change
 * instead of twenty per second, with a 10 s self-healing re-push.
 * Do not "helpfully" restore the periodic refresh.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include "k04_mini_layout.dtsi"

&pinctrl {
    /* MOSI only: WS2812 is single-wire, the SPIM clock never leaves
     * the chip. P0.30 is the LED data line on both halves. */
    k04_spi3_default: k04_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 30)>;
        };
    };

    k04_spi3_sleep: k04_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 30)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&k04_spi3_default>;
    pinctrl-1 = <&k04_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;
        chain-length = <1>; /* single onboard indicator LED */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
      zmk,kscan = &kscan0;
      zmk,physical-layout = &physical_layout;
      zmk,battery = &vbatt;
      zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <4>;
// | ESC  | Q    | W    | E    | R    | T    |                   | Y    | U    | I    | O    | P    | BSPC  |
// | TAB  | A    | S    | D    | F    | G    |                   | H    | J    | K    | L    | ;    | \     |
// | SHFT | Z    | X    | C    | V    | B    | _  |    _  | N    | M    | ,    | .    | '    | SHFT |
//                    | `    | GUI  | CTRL | MO1  | SPACE | ENTER | MO2  | ALT  | [    | ]    |
      map = <
RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0) RC(3,0) RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                 RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
      >;
    };

    kscan0: kscan {
      diode-direction = "col2row";
      wakeup-source;
    };

    vbatt: vbatt {
        status = "okay";
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 7>;
        output-ohms = <1564000>;
        full-ohms = <(806000 + 1564000)>;
    };

    touchpad_listener: touchpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        touchpad_split: touchpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "disabled";
        };
    };
};
