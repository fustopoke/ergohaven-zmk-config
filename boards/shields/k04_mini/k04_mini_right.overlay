#include "k04_mini.dtsi"
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";

    col-gpios
        = <&gpio1  6 GPIO_ACTIVE_HIGH>
        , <&gpio1  4 GPIO_ACTIVE_HIGH>
        , <&gpio1  2 GPIO_ACTIVE_HIGH>
        , <&gpio1  0 GPIO_ACTIVE_HIGH>
        , <&gpio0 22 GPIO_ACTIVE_HIGH>
        , <&gpio0 20 GPIO_ACTIVE_HIGH>
        ;

    row-gpios
        = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

/*
 * Touchpad module (Azoteq IQS5xx @ 0x74) on TWI1: SDA P0.24, SCL P0.13.
 * The K:04 module socket does not route the chip's RDY line to the MCU,
 * so the driver runs in polling mode (k04-polling branch of the
 * zmk-driver-azoteq-iqs5xx fork referenced in config/west.yml).
 */
&pinctrl {
    k04_i2c1_default: k04_i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                <NRF_PSEL(TWIM_SCL, 0, 13)>;
            /* RMK enables internal SDA/SCL pull-ups on the K:04
             * touchpad module; match that bus configuration. */
            bias-pull-up;
        };
    };

    k04_i2c1_sleep: k04_i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 24)>,
                <NRF_PSEL(TWIM_SCL, 0, 13)>;
            low-power-enable;
        };
    };
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&k04_i2c1_default>;
    pinctrl-1 = <&k04_i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    k04_touchpad: k04_touchpad@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;

        /* Module orientation: rotate reported motion 90° clockwise
         * (switch-xy + flip-x), then invert up/down (flip-y). */
        switch-xy;
        flip-x;
        flip-y;

        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;
        scroll;
    };
};

&touchpad_split {
    /* Peripheral side of the split input relay: attach the touchpad
     * to split channel 0 so its events travel to the central half.
     * (Same wiring as ergohaven's velvet_v3_ui_right_qube overlay.) */
    status = "okay";
    device = <&k04_touchpad>;
};
