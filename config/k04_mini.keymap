/*
 * K:04 Mini keymap — translated from Ergo Haven's RMK default layout
 * (ergohaven/rmk, keyboards/k04/keyboard_mini.toml).
 *
 * Intentional deviations from the RMK default:
 *  - Adjust layer: RMK "User" slots are replaced with ZMK Bluetooth profile
 *    keys (BT_SEL 0..4, BT_CLR_ALL) and &studio_unlock, mirroring the
 *    ergohaven k03 ZMK keymap.
 *  - Encoder bindings are omitted (no encoder module in this build).
 *  - The two inner thumb positions ((3,0) / (7,0) in RMK's map) are unbound
 *    in the RMK default too; they are &trans here.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp Q     &kp W      &kp E  &kp R      &kp T                    &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A     &kp S      &kp D  &kp F      &kp G                    &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp BSLH
&kp LSHFT  &kp Z     &kp X      &kp C  &kp V      &kp B  &trans  &trans    &kp N      &kp M  &kp COMMA  &kp DOT   &kp SQT   &kp RSHFT
&kp GRAVE  &kp LGUI  &kp LCTRL  &mo 1  &kp SPACE                           &kp ENTER  &mo 2  &kp LALT   &kp LBKT  &kp RBKT
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
&trans     &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                             &kp N6  &kp N7    &kp N8    &kp N9    &kp N0      &trans
&trans     &kp HOME   &kp INS  &kp DEL  &kp END  &kp RET                            &trans  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT   &trans
&trans     &trans     &trans   &trans   &trans   &kp PRINTSCREEN  &trans  &trans    &trans  &trans    &trans    &trans    &trans      &trans
&kp PG_DN  &kp PG_UP  &trans   &mo 3    &trans                                      &trans  &mo 3     &trans    &kp CAPS  &caps_word
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans  &kp LS(N2)  &kp LS(COMMA)  &kp EQUAL     &kp LS(DOT)  &kp GRAVE                        &kp CARET   &kp LS(SQT)   &kp LS(MINUS)  &kp SQT       &trans      &trans
&trans  &kp BSLH    &kp LS(N9)     &kp MINUS     &kp LS(N0)   &kp LS(EQUAL)                    &kp LS(N5)  &kp LS(LBKT)  &kp SEMI       &kp LS(RBKT)  &kp LS(N1)  &trans
&trans  &kp LS(N3)  &kp LS(N8)     &kp LS(SEMI)  &kp FSLH     &trans         &trans  &trans    &trans      &kp LS(BSLH)  &kp LS(GRAVE)  &kp LS(N7)    &kp LS(N4)  &trans
&trans  &trans      &trans         &mo 3         &trans                                        &trans      &trans        &trans         &trans        &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &trans        &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans        &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
&trans       &trans  &trans  &trans   &trans                              &trans        &trans        &trans            &trans        &trans
            >;

            display-name = "Adjust";
        };

        pointing {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans                    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans                              &trans  &trans    &trans    &trans    &trans
            >;

            display-name = "Pointing";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
