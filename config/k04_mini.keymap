/*
 * K:04 Mini keymap — RuEn edition, ported from the user's Entropy export
 * (k_04_mini_bt1.entlayout) onto ergohaven's RuEn architecture
 * (ergohaven-zmk/config/k03_ruen.keymap, ZMK v0.3.0).
 *
 * Layers:
 *   0 en      — base, English (OS layout: English)
 *   1 ru      — base, Russian (OS layout: Russian; letters ride the OS
 *               translit automatically, symbol keys use RU_* aliases)
 *   2 nav     — navigation/numbers, shared between languages
 *   3 sym_en  — symbols, entered from the en layer
 *   4 sym_ru  — symbols, entered from the ru layer
 *   5 adj     — adjust (BT profiles, media, outputs, language keys)
 *   6 pointing
 *
 * Language switching (macOS toggle model):
 *   - Ctrl+Space on the spacebar (mod-morph lg_space) flips the OS input
 *     source and the keyboard layer together;
 *   - the top-right key on each base layer goes to the other language;
 *   - adj layer: explicit RU / EN keys, and SYNC (&os_lang_tog) which
 *     flips ONLY the OS input source — press it once when the Mac and
 *     the keyboard disagree (e.g. after boot) to re-align the Mac with
 *     the current layer.
 * The OS shortcut is sent by the `os_lang_tog` macro (Ctrl+Space, the
 * macOS default for "Select the previous input source"; Cmd+Space is
 * Spotlight). If your input-source shortcut differs, change that one
 * macro. ergohaven's original uses unconditional Ctrl+Shift+1/2
 * selectors — swap the os_lang_tog body for `&kp LS(LC(N1))` /
 * `&kp LS(LC(N2))` to use that model (requires OS-side configuration).
 *
 * Symbols that don't exist in the Russian layout (like { } & $ ~ @ ^) are
 * typed through the parameterized `&en` macro: it switches the OS to
 * English, taps the symbol, and switches back — including correct
 * hold handling.
 *
 * Note: caps_word on the nav layer works for English; ZMK's Caps Word
 * can't capitalize Russian Б (it lives on the DOT key) — an RuEn-specific
 * workaround can be added later if needed.
 */

#include "keys_ru.h"
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* Status-LED battery indication (Adjust layer). Defined inline so the
     * keymap-editor can parse this file; binding comes from
     * zmk-smart-rgbled-widget at build time. */

    behaviors {
        ind_bat: ind_bat {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-battery;
        };

        lg_space: lg_space {
            compatible = "zmk,behavior-mod-morph";
            label = "LG_SPACE";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&lg_tog>;

            mods = <(MOD_LCTL)>;
        };

        /* ru-layer key right of ю: a plain slash scancode types "." in
         * the Russian OS layout and "," with Shift — the standard
         * bilingual /? key, no macro needed. The en layer's C11 uses
         * the same scancode ("/" and "?" in English). */
    };

    /* No combos: the previous E+R language combo (key-positions 3 4)
     * misfired on fast "er"/"re" typing rolls and switched the language
     * mid-word. Use the top-right key, Ctrl+Space, or the Adjust-layer
     * RU/EN/SYNC keys instead. */

    macros {
        /* Sends the OS input-source toggle. Change here if your
         * shortcut is not Cmd+Space (e.g. &kp LC(SPACE)). */

        os_lang_tog: os_lang_tog {
            compatible = "zmk,behavior-macro";
            label = "OS_LANG_TOG";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Full language toggle: OS input source + keyboard layer. */

        lg_tog: lg_tog {
            compatible = "zmk,behavior-macro";
            label = "LG_TOG";
            #binding-cells = <0>;
            bindings = <&os_lang_tog &tog 1>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            label = "LAYER_EN";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang_tog>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            label = "LAYER_RU";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang_tog>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Parameterized: type an English-only symbol from the ru layer —
         * switch OS to English, handle press/hold, switch back. */

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            label = "EN";
            #binding-cells = <1>;
            bindings =
                <&os_lang_tog>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang_tog>;

            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&gresc     &kp Q     &kp W      &kp E  &kp R      &kp T                    &kp Y      &kp U  &kp I      &kp O     &kp P     &layer_ru
&kp TAB    &kp A     &kp S      &kp D  &kp F      &kp G                    &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C  &kp V      &kp B  &trans  &trans    &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LALT   &kp LGUI  &kp LCTRL  &mo 2  &lg_space                           &kp ENTER  &mo 3  &kp BSPC   &kp LBKT  &kp RBKT
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&gresc     &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE         &layer_en
&kp TAB    &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE        &kp RU_CYRILLIC_E
&kp LSHFT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans  &trans    &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU             &kp FSLH                  &kp RSHFT
&kp LALT   &kp LGUI                 &kp LCTRL             &mo 2               &lg_space                                                 &kp ENTER           &mo 4                      &kp BSPC             &kp RU_CYRILLIC_HA     &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            bindings = <
&trans     &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                       &kp N6  &kp N7    &kp N8  &kp N9    &kp N0      &kp MINUS
&trans     &kp HOME   &kp INS  &kp DEL  &kp END  &kp RET                      &trans  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT   &trans
&trans     &trans     &trans   &trans   &trans   &kp PSCRN  &trans  &trans    &trans  &trans    &trans  &trans    &trans      &trans
&kp PG_UP  &kp PG_DN  &trans   &trans   &trans                                &trans  &mo 5     &trans  &kp CAPS  &caps_word
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &kp AT    &kp LT     &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp DQT   &kp UNDER  &kp SQT   &trans    &trans
&trans  &kp BSLH  &kp LPAR   &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&none   &kp HASH  &kp ASTRK  &kp COLON  &kp FSLH  &none      &trans  &trans    &none      &kp PIPE  &kp TILDE  &kp AMPS  &kp DLLR  &none
&trans  &trans    &trans     &mo 5      &trans                                 &trans     &trans    &trans     &trans    &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols (Ru)";
            bindings = <
&trans  &en AT    &en LT        &kp EQUAL     &en GT    &en GRAVE                    &en CARET  &kp RU_DQT  &kp UNDER    &en SQT   &trans    &trans
&trans  &kp RU_BSLH  &kp LPAR   &kp MINUS     &kp RPAR  &kp PLUS                     &kp PRCNT  &en LBRC    &kp RU_SEMI  &en RBRC  &kp EXCL  &trans
&none   &en HASH  &kp RU_ASTRK  &kp RU_COLON  &kp RU_FSLH  &none  &trans  &trans     &none      &en PIPE    &en TILDE    &en AMPS  &en DLLR  &none
&trans  &trans    &trans        &mo 5         &trans                                 &trans     &trans      &trans       &trans    &trans
            >;
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &layer_ru     &layer_en
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &os_lang_tog        &ind_bat
&trans       &trans  &trans  &trans   &trans                              &trans        &trans        &trans            &trans        &trans
            >;

            display-name = "Adjust";
        };

        pointing {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &none   &mkp MB3  &mkp MB2  &mkp MB1  &none                     &none   &mkp MB1  &mkp MB2  &mkp MB3  &none   &trans
&trans  &trans  &trans    &trans    &trans    &none   &trans  &trans    &none   &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans                              &trans  &trans    &trans    &trans    &trans
            >;

            display-name = "Pointing";
        };
    };
};
