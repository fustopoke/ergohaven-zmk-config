/*
 * K:04 Mini keymap — translated 1:1 from the Entropy export
 * (k_04_mini_bt1.entlayout, "K:04 Mini BT1", RMK/Rynk firmware).
 *
 * Vendor keycodes from ergohaven's vial_mini_universal.json:
 *   0x7E13..17 BT0..BT4, 0x7E1A BT_CLR, 0x7E1C/1D/1E EH_SNP/SCR/TXT
 *   0x7E25 BT_OUT, 0x7E26 USB_OUT, 0x7E27 BT_BATTERY
 * QMK specials via Entropy's keycode table:
 *   0x7C16 GESC, 0x7C00 QK_BOOT, 0x7C73 CAPS_WORD_TOGGLE
 * Layer switches 0x522x = LayerOn(x) = MO(x+1).
 *
 * Note: the four pointing-mode keys (EH_SNP/EH_SCR/EH_TXT, RMK touchpad
 * sniper/scroll/text modes) have no ZMK equivalent in the iqs5xx driver
 * and are mapped to &none until support is added.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* Status-LED battery indication (Adjust layer). Defined inline
     * rather than including the widget module's dtsi so the
     * keymap-editor can parse this file; the compatible and its
     * binding come from zmk-smart-rgbled-widget at build time. */
    behaviors {
        ind_bat: ind_bat {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-battery;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&gresc     &kp Q      &kp W      &kp E      &kp R      &kp T                        &kp Y      &kp U      &kp I      &kp O      &kp P      &none
&kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G                        &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &trans   &trans   &kp N      &kp M      &kp COMMA  &kp DOT    &kp SQT    &kp RSHFT
                       &kp LALT   &kp LGUI   &kp LCTRL  &mo 1      &kp SPACE          &kp ENTER  &mo 2      &kp BSPC   &kp LBKT   &kp RBKT
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
&trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                       &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&trans     &kp HOME   &kp INS    &kp DEL    &kp END    &kp RET                      &trans     &kp LEFT   &kp UP     &kp DOWN   &kp RIGHT  &trans
&trans     &trans     &trans     &trans     &trans     &kp PSCRN  &trans   &trans   &trans     &trans     &trans     &trans     &trans     &trans
                       &kp PG_UP  &kp PG_DN  &trans     &trans     &trans            &trans     &mo 3      &trans     &kp CAPS   &caps_word
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans     &kp AT     &none      &kp EQUAL  &none      &kp GRAVE                    &kp CARET  &kp DQT    &kp UNDER  &kp SQT    &trans     &trans
&trans     &trans     &kp LPAR   &kp MINUS  &kp RPAR   &kp PLUS                     &kp PRCNT  &kp LBRC   &kp SEMI   &kp RBRC   &kp EXCL   &trans
&none      &kp HASH   &kp ASTRK  &kp COLON  &none      &none      &trans   &trans   &none      &none      &kp TILDE  &kp AMPS   &kp DLLR   &none
                       &trans     &trans     &trans     &mo 3      &trans            &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader &trans    &kp F1     &kp F2     &kp F3     &kp F4                       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR_ALL
&trans      &trans    &kp F5     &kp F6     &kp F7     &kp F8                       &out OUT_BLE &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans     &trans
&trans      &trans    &kp F9     &kp F10    &kp F11    &kp F12    &trans   &trans  &out OUT_USB &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT &trans     &ind_bat
                       &trans     &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "Adjust";
        };

        pointing {
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans                      &trans     &trans     &trans     &trans     &trans     &trans
&trans     &none      &mkp MB3   &mkp MB2   &mkp MB1   &none                       &none      &mkp MB1   &mkp MB2   &mkp MB3   &none      &trans
&trans     &trans     &trans     &trans     &trans     &none      &trans   &trans  &none      &trans     &trans     &trans     &trans     &trans
                       &trans     &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans     &trans
            >;

            display-name = "Pointing";
        };
    };
};
