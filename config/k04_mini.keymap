/*
 * K:04 Mini keymap — RuEn edition, cross-OS (Linux / Windows / macOS).
 *
 * See ../CROSS_OS.md for the host-side setup each OS expects and for the
 * touchpad knobs. Nothing here is per-OS: one keymap runs everywhere and a
 * single marked line (plus one modifier mask) selects the host shortcut
 * that switches the OS input source.
 *
 * Layers:
 *   0 en      — base, English (OS layout: English)
 *   1 ru      — base, Russian (OS layout: Russian; letters ride the OS
 *               translit automatically, symbol keys use RU_* aliases)
 *   2 nav     — navigation/numbers, shared between languages
 *   3 sym_en  — symbols, entered (momentary) from the en layer — the OS is
 *               already English there, so plain &kp scancodes
 *   4 sym_ru  — SYMBOL SESSION, entered from the ru layer via T7
 *               (&sym_enter): the host is *set* to layout 1 (English) for
 *               the whole session and this layer carries the same plain
 *               symbol layout as sym_en; the T7 position on it is
 *               &sym_exit, which *sets* the host back to layout 2
 *               (Russian) and returns to the ru base
 *   5 adj     — adjust (BT profiles, media, outputs, language keys)
 *   6 pointing — extra mouse buttons under the fingers while held
 *
 * Language switching — ABSOLUTE anchors (one keymap, every OS):
 *   - The keyboard layer is the source of truth; every action that changes
 *     it also changes the OS input source, and nothing else does.
 *   - Host switches are absolute — "select layout 1 = English",
 *     "select layout 2 = Russian" — not a relative "next source". KDE
 *     ships these actions (System Settings → Shortcuts → Keyboard Layout →
 *     "Select Keyboard Layout"), bind them to Meta+Ctrl+1 / Meta+Ctrl+2
 *     (same anchors as the OP36 RuEn keymap). macOS: Ctrl+Shift+1/2 via
 *     LS(LC(N1))/LS(LC(N2)). Absolute commands are idempotent, so host
 *     key-event coalescing/debounce can no longer desync anything: the
 *     LAST command always states the truth.
 *   - A12 (top-right) on each base layer: &layer_ru / &layer_en set BOTH
 *     the layer (&to) and the host (&os_sel_*).
 *   - Spacebar with Super held: per-base mod-morphs — &lg_space_en on the
 *     en base (= &layer_ru), &lg_space_ru on the ru base (= &layer_en).
 *   - Adjust layer: LANG (&lg_tog) still cycles "next source + tog layer"
 *     as a layer-blind fallback; SYNC (&os_lang_tog) flips ONLY the OS
 *     input source (relative escape hatch after an external change);
 *     MOUSE (&mo 6) reaches the pointing layer; the outermost right thumb
 *     key (&k04_layer_led 0 2) toggles the always-lit white base light.
 *   - The status LED shows only the official battery/BT/connect language
 *     (per-layer colors were switched off by user request). If layer and
 *     OS ever drift apart (a foreign keyboard changed the layout), press
 *     A12 twice or SYNC once to re-anchor.
 *
 * Symbols that don't exist in the Russian layout ({ } & $ ~ @ ^): T7 on
 * the ru layer enters the sym session (host SET to English, layer 4 —
 * plain EN-position scancodes); T7 again exits (host SET back to
 * Russian). Unlike the old per-symbol &en / per-hold toggle schemes,
 * rapid or repeated T7 taps cannot break the parity: every press issues
 * an absolute target, not a blind flip.
 *
 * Note: caps_word on the nav layer works for English; ZMK's Caps Word
 * can't capitalize Russian Б (it lives on the DOT key) — an RuEn-specific
 * workaround can be added later if needed.
 */

#include "keys_ru.h"
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <behaviors/layer_led.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* Status-LED battery indication (Adjust layer). Defined inline so the
     * keymap-editor can parse this file; binding comes from
     * zmk-smart-rgbled-widget at build time. */

    behaviors {
        ind_bat: ind_bat {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-battery;
        };

        /* HOST SETUP #2 (see CROSS_OS.md): which modifier held over the
         * spacebar means "switch input source". With the absolute-anchor
         * redesign the morph target is layer_ru/layer_en — each sets the
         * host to a DEFINITE layout (Meta+Ctrl+1/2, KDE), so the held
         * Super simply becomes part of the anchor chord:
         *   KDE / Windows-anchored (current)  -> MOD_LGUI  (Super held)
         *   macOS (Ctrl+Shift+1/2 anchors)    -> MOD_LCTL
         * Two variants, one per base layer, so the space chord is also a
         * definite target and never a blind toggle. A plain space is sent
         * when no modifier is held. */
        lg_space_en: lg_space_en {
            compatible = "zmk,behavior-mod-morph";
            label = "LG_SPACE_EN";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_ru>;

            mods = <(MOD_LGUI)>;
        };

        lg_space_ru: lg_space_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "LG_SPACE_RU";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_en>;

            mods = <(MOD_LGUI)>;
        };

        /* ru-layer key right of ю: a plain slash scancode types "." in
         * the Russian OS layout and "," with Shift — the standard
         * bilingual /? key, no macro needed. The en layer's C11 uses
         * the same scancode ("/" and "?" in English). */
    };

    /* No combos: the previous E+R language combo (key-positions 3 4)
     * misfired on fast "er"/"re" typing rolls and switched the language
     * mid-word. Use the top-right key, the spacebar chord, or the
     * Adjust-layer LANG/SYNC keys instead. */

    macros {
        /* =====================================================================
         * HOST SETUP #1 — the single place that knows which OS the keyboard is
         * talking to. Every language action runs &os_lang_tog, so switching
         * target OS means editing exactly ONE line: the one marked ACTIVE.
         *
         * Each preset asks the host to move to the NEXT input source:
         *   os_next_linux_win  Super+Space — the default on GNOME and on
         *                      Windows 10/11. No host configuration needed.
         *                      KDE sometimes ships this on Alt+Shift instead:
         *                      check System Settings → Shortcuts → Keyboard
         *                      Layout and make the preset match the host.
         *   os_next_mac        Ctrl+Space  — macOS default "Select the previous
         *                      input source". No host configuration needed.
         *   os_next_x11        Alt+Shift   — X11/xkb layouts grouping; needs
         *                      `setxkbmap -option grp:alt_shift_toggle` (or add
         *                      it to your xorg.conf / desktop layout options).
         *
         * Do NOT fire several shortcuts at once to "cover every OS": it looks
         * harmless but it is not. Ctrl+Space is the completion shortcut in
         * every editor on Linux/Windows, Shift+Shift is grabbable too, and an
         * extra accepted shortcut flips the layout an odd number of times —
         * which is exactly how the keyboard layer and the OS layout drifted
         * apart. Pick the one line for the OS you are on.
         * ===================================================================== */

        os_next_linux_win: os_next_linux_win {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_LW";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        os_next_mac: os_next_mac {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_MAC";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        os_next_x11: os_next_x11 {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_X11";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LALT>,
                <&macro_press &kp RSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_release &kp LALT>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Ask the host to switch input source (RELATIVE "next"). After the
         * absolute-anchor redesign this is a fallback used only by the
         * Adjust-layer SYNC key — every normal path below sends a definite
         * target instead. macOS users: swap in <&os_next_mac>. */

        os_lang_tog: os_lang_tog {
            compatible = "zmk,behavior-macro";
            label = "OS_LANG_TOG";
            #binding-cells = <0>;
            bindings = <&os_next_linux_win>; /* ← ACTIVE: the one line to change */
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* HOST SETUP #3 — the absolute anchors (KDE's "Select Keyboard
         * Layout 1/2" actions, bound once in System Settings to
         * Meta+Ctrl+1 / Meta+Ctrl+2; macOS's "Select the source 1/2"
         * uses LS(LC(N1))/LS(LC(N2)) with Ctrl+Shift+1/2). Layout NUMBER
         * = position in the host's input-source list: English FIRST,
         * Russian SECOND. Every language action sends one of these two —
         * idempotent, so a coalesced or repeated chord cannot drift the
         * state, the last command always states the truth. */

        os_sel_en: os_sel_en {
            compatible = "zmk,behavior-macro";
            label = "OS_SEL_EN";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N1))>; /* KDE/Windows anchors */
            wait-ms = <0>;
            tap-ms = <30>;
        };

        os_sel_ru: os_sel_ru {
            compatible = "zmk,behavior-macro";
            label = "OS_SEL_RU";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(N2))>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Full language toggle: OS input source + keyboard layer. Used by the
         * spacebar chord and by the Adjust-layer LANG key, where the current
         * base layer is not encoded in the binding. */

        lg_tog: lg_tog {
            compatible = "zmk,behavior-macro";
            label = "LG_TOG";
            #binding-cells = <0>;
            bindings = <&os_lang_tog &tog 1>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* A12 on each base layer, and the targets of the per-base
         * spacebar morphs: set the KEYBOARD layer and the HOST layout to
         * one definite target in a single action. Absolute on both sides,
         * so no sequence of presses can land in a half-switched state. */

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            label = "LAYER_EN";
            #binding-cells = <0>;
            bindings = <&to 0 &os_sel_en>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            label = "LAYER_RU";
            #binding-cells = <0>;
            bindings = <&to 1 &os_sel_ru>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* T7 while the ru base layer is active: enter the symbol
         * SESSION — host SET to English, sticky layer 4 (EN-position
         * symbol layout, see the sym_ru node). T7 again on layer 4 runs
         * sym_exit: host SET back to Russian, back to the ru base.
         *
         * Sticky (not momentary) on purpose: the two previous designs —
         * per-symbol &en toggles, then a per-hold toggle pair — both
         * died on repeated quick T7 taps, because a relative "next
         * source" issued twice in a burst can be coalesced by the host
         * into one switch and the parity is gone. Here every press
         * states an absolute target instead; interleaving is harmless.
         * Typing letters inside the session types Latin (the host is
         * English) — that is the deal the session makes; exit is one
         * thumb tap. */

        sym_enter: sym_enter {
            compatible = "zmk,behavior-macro";
            label = "SYM_ENTER";
            #binding-cells = <0>;
            bindings = <&os_sel_en &to 4>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        sym_exit: sym_exit {
            compatible = "zmk,behavior-macro";
            label = "SYM_EXIT";
            #binding-cells = <0>;
            bindings = <&os_sel_ru &to 1>;
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&gresc     &kp Q     &kp W      &kp E  &kp R      &kp T                    &kp Y      &kp U  &kp I      &kp O     &kp P     &layer_ru
&kp TAB    &kp A     &kp S      &kp D  &kp F      &kp G                    &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C  &kp V      &kp B  &trans  &trans    &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LALT   &kp LGUI  &kp LCTRL  &mo 2  &lg_space_en                          &kp ENTER  &mo 3  &kp BSPC   &kp LBKT  &kp RBKT
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&gresc     &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE         &layer_en
&kp TAB    &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE        &kp RU_CYRILLIC_E
&kp LSHFT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans  &trans    &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU             &kp FSLH                  &kp RSHFT
&kp LALT   &kp LGUI                 &kp LCTRL             &mo 2               &lg_space_ru                                                &kp ENTER           &sym_enter                 &kp BSPC             &kp RU_CYRILLIC_HA     &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            bindings = <
&trans     &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                       &kp N6  &kp N7    &kp N8  &kp N9    &kp N0      &kp MINUS
&trans     &kp HOME   &kp INS  &kp DEL  &kp END  &kp RET                      &trans  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT   &trans
&trans     &trans     &trans   &trans   &trans   &kp PSCRN  &trans  &trans    &trans  &trans    &trans  &trans    &trans      &trans
&kp PG_UP  &kp PG_DN  &trans   &trans   &trans                                &trans  &mo 5     &trans  &kp CAPS  &caps_word
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &kp AT    &kp LT     &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp DQT   &kp UNDER  &kp SQT   &trans    &trans
&trans  &kp BSLH  &kp LPAR   &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&none   &kp HASH  &kp ASTRK  &kp COLON  &kp FSLH  &none      &trans  &trans    &none      &kp PIPE  &kp TILDE  &kp AMPS  &kp DLLR  &none
&trans  &trans    &trans     &mo 5      &trans                                 &trans     &trans    &trans     &trans    &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols (Ru)";
            /* The EN-context symbol SESSION entered from the ru base via
             * T7 (&sym_enter): while this layer is active the host layout
             * was SET to English, so the symbols are the same plain
             * EN-position scancodes as sym_en. The T7 position carries
             * &sym_exit (host SET back to Russian, return to ru base). */
            bindings = <
&trans  &kp AT    &kp LT     &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp DQT   &kp UNDER  &kp SQT   &trans    &trans
&trans  &kp BSLH  &kp LPAR   &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&none   &kp HASH  &kp ASTRK  &kp COLON  &kp FSLH  &none      &trans  &trans    &none      &kp PIPE  &kp TILDE  &kp AMPS  &kp DLLR  &none
&trans  &trans    &trans     &mo 5      &trans                                 &trans     &sym_exit &trans     &trans    &trans
            >;
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &lg_tog       &os_lang_tog
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &mo 6               &ind_bat
&trans       &trans  &trans  &trans   &trans                              &trans        &trans        &trans            &trans        &k04_layer_led 0 2
            >;

            /* Row 1, right end: LANG (switch OS input source + keyboard layer
             * together) and SYNC (switch the OS input source only — use it to
             * re-pair after the layout was changed by mouse, system menu or a
             * second keyboard).
             * Row 2, right end: MOUSE (hold for the pointing layer's extra
             * mouse buttons) and the battery readout. */

            display-name = "Adjust";
        };

        pointing {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &none   &mkp MB3  &mkp MB2  &mkp MB1  &none                     &none   &mkp MB1  &mkp MB2  &mkp MB3  &none   &trans
&trans  &trans  &trans    &trans    &trans    &none   &trans  &trans    &none   &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans                              &trans  &trans    &trans    &trans    &trans
            >;

            /* Reachable by holding the MOUSE key (Adjust, row 2, right end of
             * the inner thumb cluster). The touchpad itself sends motion and
             * its own taps on every layer; this layer only adds the extra
             * buttons under the fingers. */

            display-name = "Pointing";
        };
    };
};
