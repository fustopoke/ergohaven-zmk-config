/*
 * K:04 Mini keymap — RuEn edition, cross-OS (Linux / Windows / macOS).
 *
 * See ../CROSS_OS.md for the host-side setup each OS expects and for the
 * touchpad knobs. Nothing here is per-OS: one keymap runs everywhere and a
 * single marked line (plus one modifier mask) selects the host shortcut
 * that switches the OS input source.
 *
 * Layers:
 *   0 en      — base, English (OS layout: English)
 *   1 ru      — base, Russian (OS layout: Russian; letters ride the OS
 *               translit automatically, symbol keys use RU_* aliases)
 *   2 nav     — navigation/numbers, shared between languages
 *   3 sym     — ONE EN-context-free symbol layer, momentary from BOTH
 *               bases via T7; every key is a &uc code point typed via
 *               UC_MODE_LINUX, so symbols work whatever layout is active
 *   4 adj     — adjust (BT profiles, media, outputs, language keys)
 *   5 pointing — extra mouse buttons under the fingers while held
 *
 * Language switching — relative "next source" (one keymap, every OS, ZERO
 * host configuration; this is the scheme the user confirmed working):
 *   - The keyboard layer is the source of truth; every action that changes
 *     it also flips the OS input source with one Super+Space, and nothing
 *     else does.
 *   - A12 (top-right) on each base layer: &layer_ru on en, &layer_en on ru.
 *     The binding comes from the CURRENT layer, so one relative "next" is
 *     always exactly the right amount — no drift, no host setup.
 *   - Spacebar with Super held: per-base mod-morphs — &lg_space_en on the
 *     en base (= &layer_ru), &lg_space_ru on the ru base (= &layer_en).
 *   - Adjust layer: LANG (&lg_tog) cycles "next source + tog layer";
 *     SYNC (&os_lang_tog) flips ONLY the OS input source (escape hatch if
 *     a mouse/system menu/second keyboard changed the layout externally);
 *     MOUSE (&mo 5) reaches the pointing layer; the outermost right thumb
 *     key (&k04_layer_led 0 2) toggles the always-lit white base light.
 *   - The status LED shows the official battery/BT/connect language plus
 *     distinct colors on the momentary layers (nav/sym/adj/pointing); the
 *     two base layers en/ru are both white — language is not LED-encoded.
 *   - If layer and OS ever drift apart, SYNC once re-pairs them.
 *
 * Symbols that don't exist in the Russian layout ({ } & $ ~ @ ^) are typed
 * from the single sym layer: T7 momentaries it from either base. Every
 * symbol key is a Unicode code point (&uc CP 0, UC_MODE_LINUX / IBus), so
 * it lands correctly whatever layout the host is in and WITHOUT any layout
 * switch — and holding T7 no longer kills the layer (the old C1/C12
 * switches used &to, which clears a held momentary; that mechanism is
 * gone). The host needs IBus/the GTK input method (CROSS_OS.md → Unicode).
 *
 * Note: caps_word on the nav layer works for English; ZMK's Caps Word
 * can't capitalize Russian Б (it lives on the DOT key) — an RuEn-specific
 * workaround can be added later if needed.
 */

#include "keys_ru.h"
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <behaviors/layer_led.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/unicode.dtsi>

/* The sym layer types code points via &uc so that English-only symbols
 * (@ { } ~ …) come out right whatever OS layout is active, WITHOUT the
 * firmware switching the layout (see CROSS_OS.md → Unicode input).
 * UC_MODE_LINUX = Ctrl+Shift+U, hex, Space (IBus / GTK). Change to
 * UC_MODE_WIN_COMPOSE / UC_MODE_MACOS for those hosts, or add
 * UC_SET_* keys to a layer to switch on the fly. Requires the host IME
 * to be running (see docs). */
&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {
    /* Status-LED battery indication (Adjust layer). Defined inline so the
     * keymap-editor can parse this file; binding comes from
     * zmk-smart-rgbled-widget at build time. */

    behaviors {
        ind_bat: ind_bat {
            compatible = "zmk,behavior-rgbled-widget";
            #binding-cells = <0>;
            indicate-battery;
        };

        /* HOST SETUP #2 (see CROSS_OS.md): which modifier held over the
         * spacebar means "switch input source". It must be EXACTLY the
         * modifier the switch macros send (Switch 1 = Super+Space, so
         * Super), because the morph reuses the key you physically hold:
         * the held modifier and the macro's own combine into the chord
         * the host sees.
         *   Linux / Windows (Super+Space)  -> MOD_LGUI   (current)
         *   macOS (Ctrl+Space)             -> MOD_LCTL
         * Two variants, one per base layer (targets layer_ru / layer_en),
         * so the chord moves exactly one step in the right direction,
         * never a blind toggle. A plain space is sent with no modifier. */
        lg_space_en: lg_space_en {
            compatible = "zmk,behavior-mod-morph";
            label = "LG_SPACE_EN";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_ru>;

            mods = <(MOD_LGUI)>;
        };

        lg_space_ru: lg_space_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "LG_SPACE_RU";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_en>;

            mods = <(MOD_LGUI)>;
        };

        /* ru-layer key right of ю: a plain slash scancode types "." in
         * the Russian OS layout and "," with Shift — the standard
         * bilingual /? key, no macro needed. The en layer's C11 uses
         * the same scancode ("/" and "?" in English). */
    };

    /* No combos: the previous E+R language combo (key-positions 3 4)
     * misfired on fast "er"/"re" typing rolls and switched the language
     * mid-word. Use the top-right key, the spacebar chord, or the
     * Adjust-layer LANG/SYNC keys instead. */

    macros {
        /* =====================================================================
         * HOST SETUP #1 — the single place that knows which OS the keyboard is
         * talking to. Every language action runs &os_lang_tog, so switching
         * target OS means editing exactly ONE line: the one marked ACTIVE.
         *
         * Each preset asks the host to move to the NEXT input source:
         *   os_next_linux_win  Super+Space — the default on GNOME and on
         *                      Windows 10/11. No host configuration needed.
         *                      KDE sometimes ships this on Alt+Shift instead:
         *                      check System Settings → Shortcuts → Keyboard
         *                      Layout and make the preset match the host.
         *   os_next_mac        Ctrl+Space  — macOS default "Select the previous
         *                      input source". No host configuration needed.
         *   os_next_x11        Alt+Shift   — X11/xkb layouts grouping; needs
         *                      `setxkbmap -option grp:alt_shift_toggle` (or add
         *                      it to your xorg.conf / desktop layout options).
         *
         * Do NOT fire several shortcuts at once to "cover every OS": it looks
         * harmless but it is not. Ctrl+Space is the completion shortcut in
         * every editor on Linux/Windows, Shift+Shift is grabbable too, and an
         * extra accepted shortcut flips the layout an odd number of times —
         * which is exactly how the keyboard layer and the OS layout drifted
         * apart. Pick the one line for the OS you are on.
         * ===================================================================== */

        os_next_linux_win: os_next_linux_win {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_LW";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        os_next_mac: os_next_mac {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_MAC";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        os_next_x11: os_next_x11 {
            compatible = "zmk,behavior-macro";
            label = "OS_NEXT_X11";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LALT>,
                <&macro_press &kp RSHFT>,
                <&macro_release &kp RSHFT>,
                <&macro_release &kp LALT>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Ask the host to switch input source — the RELATIVE "next source"
         * chord. This is the stock shortcut on GNOME/KDE/Windows
         * (Super+Space), so the keymap needs ZERO host configuration.
         * Parity holds because every binding that toggles also moves the
         * keyboard layer one step, and the switch keys live on the layer
         * you are currently on (A12 on en = go RU, A12 on ru = go EN; the
         * sym layer's C1/C12 follow the same one-step rule). macOS users:
         * swap in <&os_next_mac> below. */

        os_lang_tog: os_lang_tog {
            compatible = "zmk,behavior-macro";
            label = "OS_LANG_TOG";
            #binding-cells = <0>;
            bindings = <&os_next_linux_win>; /* ← ACTIVE: the one line to change */
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* Full language toggle: OS input source + keyboard layer. Used by the
         * spacebar chord and by the Adjust-layer LANG key, where the current
         * base layer is not encoded in the binding. */

        lg_tog: lg_tog {
            compatible = "zmk,behavior-macro";
            label = "LG_TOG";
            #binding-cells = <0>;
            bindings = <&os_lang_tog &tog 1>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        /* A12 on each base layer, and the targets of the per-base spacebar
         * morphs. Because the binding comes from the layer that is CURRENTLY
         * active, a single relative "next source" is always the right amount:
         * on the en base the key is layer_ru (→ Russian), on the ru base it
         * is layer_en (→ English). No host configuration required. */

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            label = "LAYER_EN";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang_tog>;
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            label = "LAYER_RU";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang_tog>;
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&gresc     &kp Q     &kp W      &kp E  &kp R      &kp T                    &kp Y      &kp U  &kp I      &kp O     &kp P     &layer_ru
&kp TAB    &kp A     &kp S      &kp D  &kp F      &kp G                    &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C  &kp V      &kp B  &trans  &trans    &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
&kp LALT   &kp LGUI  &kp LCTRL  &mo 2  &lg_space_en                          &kp ENTER  &mo 3  &kp BSPC   &kp LBKT  &kp RBKT
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&gresc     &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE         &layer_en
&kp TAB    &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE        &kp RU_CYRILLIC_E
&kp LSHFT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans  &trans    &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU             &kp FSLH                  &kp RSHFT
&kp LALT   &kp LGUI                 &kp LCTRL             &mo 2               &lg_space_ru                                                &kp ENTER           &mo 3                    &kp BSPC             &kp RU_CYRILLIC_HA     &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            bindings = <
&trans     &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                       &kp N6  &kp N7    &kp N8  &kp N9    &kp N0      &kp MINUS
&trans     &kp HOME   &kp INS  &kp DEL  &kp END  &kp RET                      &trans  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT   &trans
&trans     &trans     &trans   &trans   &trans   &kp PSCRN  &trans  &trans    &trans  &trans    &trans  &trans    &trans      &trans
&kp PG_UP  &kp PG_DN  &trans   &trans   &trans                                &trans  &mo 4     &trans  &kp CAPS  &caps_word
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans   &uc 0x40 0  &uc 0x3C 0  &uc 0x3D 0  &uc 0x3E 0  &uc 0x60 0           &uc 0x5E 0  &uc 0x22 0  &uc 0x5F 0  &uc 0x27 0  &trans   &trans
&trans   &uc 0x5C 0  &uc 0x28 0  &uc 0x2D 0  &uc 0x29 0  &uc 0x2B 0           &uc 0x25 0  &uc 0x5B 0  &uc 0x3B 0  &uc 0x5D 0  &uc 0x21 0 &trans
&none    &uc 0x23 0  &uc 0x2A 0  &uc 0x3A 0  &uc 0x2F 0  &none   &trans &trans &none       &uc 0x7C 0  &uc 0x7E 0  &uc 0x26 0  &uc 0x24 0 &none
&trans   &trans    &trans      &mo 4      &trans                              &trans     &trans    &trans     &trans    &trans
            >;

            /* ONE symbol layout for BOTH bases (3/4 merged by user
             * request). Every symbol is a Unicode code point (&uc CP 0)
             * typed via UC_MODE_LINUX, so it comes out correct no matter
             * which OS layout is active and WITHOUT any layout switch —
             * this is why the old T7+C1/C12 switches (which also cleared
             * the held momentary layer via &to) are gone. Hold T7, type
             * symbols, release. Language switching lives on A12 and the
             * spacebar morph only. The shift positions are &none so a
             * stray thumb on shift cannot disrupt the layer. */

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &lg_tog       &os_lang_tog
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &mo 5               &ind_bat
&trans       &trans  &trans  &trans   &trans                              &trans        &trans        &trans            &trans        &k04_layer_led 0 2
            >;

            /* Row 1, right end: LANG (switch OS input source + keyboard layer
             * together) and SYNC (switch the OS input source only — use it to
             * re-pair after the layout was changed by mouse, system menu or a
             * second keyboard).
             * Row 2, right end: MOUSE (hold for the pointing layer's extra
             * mouse buttons) and the battery readout. */

            display-name = "Adjust";
        };

        pointing {
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &none   &mkp MB3  &mkp MB2  &mkp MB1  &none                     &none   &mkp MB1  &mkp MB2  &mkp MB3  &none   &trans
&trans  &trans  &trans    &trans    &trans    &none   &trans  &trans    &none   &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans                              &trans  &trans    &trans    &trans    &trans
            >;

            /* Reachable by holding the MOUSE key (Adjust, row 2, right end of
             * the inner thumb cluster). The touchpad itself sends motion and
             * its own taps on every layer; this layer only adds the extra
             * buttons under the fingers. */

            display-name = "Pointing";
        };
    };
};
